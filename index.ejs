<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= usuario.title %></title>
    <%- usuario.meta_tags || '' %>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: linear-gradient(135deg, #0f0c29, #302b63, #24243e); color: #fff; margin: 0; padding: 20px; display: flex; justify-content: center; min-height: 100vh; }
        .container { width: 100%; max-width: 450px; text-align: center; margin-top: 30px; }
        .logo { width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #00ffcc; margin-bottom: 15px; box-shadow: 0 0 15px rgba(0,255,204,0.5); }
        h1 { font-size: 24px; margin-bottom: 30px; color: #fff; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
        .link-btn { display: block; background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); color: #fff; padding: 15px; margin-bottom: 15px; border-radius: 30px; text-decoration: none; font-weight: bold; border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s ease; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .link-btn:hover { background: #00ffcc; color: #000; transform: translateY(-3px); box-shadow: 0 6px 15px rgba(0,255,204,0.4); }
    </style>
</head>
<body>
    <div class="container">
        <% if (usuario.logo) { %>
            <img src="<%= usuario.logo %>" alt="Logotipo" class="logo">
        <% } %>
        <h1><%= usuario.title %></h1>
        
        <div class="links-list">
            <% links.forEach(link => { %>
                <a href="<%= link.url %>" class="link-btn" target="_blank"><%= link.title %></a>
            <% }) %>
        </div>
    </div>
</body>
</html>
